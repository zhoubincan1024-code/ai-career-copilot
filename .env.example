# ============================================================
# AI Career Copilot · 环境变量模板
# 复制为 .env 后填写真实值（.env 已被 gitignore 忽略，勿提交）
# ============================================================

# ---- 应用 ----
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# ---- 数据库（本地开发，对应第 5 步已建库）----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_career_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_career_copilot

# ---- LLM API（第 8 步起使用，填入真实 Key）----
# 默认使用火山方舟 OpenAI 兼容接口，也可换成其他兼容服务
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=

# ---- 前端（构建时注入）----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Redis（第 16 步缓存用）----
REDIS_URL=redis://localhost:6379/0
